# Docker Compose reads .env automatically. Never store credentials here.
RISKBEX_UID=1000
RISKBEX_GID=1000
# Keep runtime output in the ignored backend/runtime tree.
# An existing validated VersionStore can be selected without copying its files.
RISKBEX_STORE=./backend/runtime/docker-main
# Required only for the opt-in scheduled profile; use existing validated inputs.
RISKBEX_SEED=./backend/runtime/inputs/seed.csv
RISKBEX_REGRESSION_RECEIPT=./backend/runtime/inputs/receipt.json
