name: MAIN private daily computation (manual until reviewed)
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: riskbex-private-daily-v1
  cancel-in-progress: false
jobs:
  candidate:
    if: github.ref == 'refs/heads/main' && vars.RISKBEX_PRIVATE_DAILY_ENABLED == 'true' && vars.RISKBEX_PRIVATE_STORAGE_AUTHORIZED == 'true'
    environment: private-daily
    permissions:
      contents: write
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    env:
      PYTHONPATH: backend
      OMP_NUM_THREADS: '1'
      OPENBLAS_NUM_THREADS: '1'
      MKL_NUM_THREADS: '1'
    defaults:
      run:
        shell: bash --noprofile --norc -euo pipefail {0}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Require private repository before restoring observations
        env:
          GH_TOKEN: ${{ github.token }}
        run: test "$(gh api "repos/$GITHUB_REPOSITORY" --jq .private)" = true
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: state/main-daily
          path: private-state
          persist-credentials: false
      - name: Capture dynamic predecessor
        id: predecessor
        run: echo "head=$(git -C private-state rev-parse HEAD)" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.11.14'
      - name: Install reviewed frozen runtime
        run: |
          python -m pip install -r backend/requirements-docker.lock
          python -m pip check
      - name: Complete guarded offline gate before retrieval
        run: python backend/scripts/run_actions_offline.py --expected-release-sha "$GITHUB_SHA"
      - name: Authorized private computation and atomic persistence
        env:
          RISKBEX_PRIVATE_DAILY_ENABLED: ${{ vars.RISKBEX_PRIVATE_DAILY_ENABLED }}
          RISKBEX_PRIVATE_STORAGE_AUTHORIZED: ${{ vars.RISKBEX_PRIVATE_STORAGE_AUTHORIZED }}
          RISKBEX_EXPECTED_REPOSITORY: ${{ github.repository }}
          PREDECESSOR: ${{ steps.predecessor.outputs.head }}
          GH_TOKEN: ${{ github.token }}
        run: |
          umask 077
          git -C private-state config user.name riskbex-private-daily
          git -C private-state config user.email riskbex-private-daily@users.noreply.github.com
          cat > "$RUNNER_TEMP/git-askpass" <<'SH'
          #!/bin/sh
          case "$1" in *Username*) printf '%s\n' x-access-token;; *) printf '%s\n' "$GH_TOKEN";; esac
          SH
          chmod 700 "$RUNNER_TEMP/git-askpass"
          export GIT_ASKPASS="$RUNNER_TEMP/git-askpass" GIT_TERMINAL_PROMPT=0
          python backend/scripts/run_private_daily.py --source-root private-state --controller-root . --work "$RUNNER_TEMP/private-candidate" --persist-head "$PREDECESSOR"
      - name: Cleanup private workspace
        if: always()
        run: rm -rf -- "$RUNNER_TEMP/private-candidate" "$RUNNER_TEMP/git-askpass" private-state
