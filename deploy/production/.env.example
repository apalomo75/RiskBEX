# Copy outside the checkout to /etc/riskbex/production.env, mode 0600.
# Absolute VPS paths only. Never point production at the local WSL store.
RISKBEX_UID=1000
RISKBEX_GID=1000
RISKBEX_RELEASE=replace-with-reviewed-git-sha
RISKBEX_DOMAIN=example.invalid
RISKBEX_STORE=/srv/riskbex/state/store
RISKBEX_SEED=/srv/riskbex/state/inputs/seed.csv
RISKBEX_REGRESSION_RECEIPT=/srv/riskbex/state/inputs/receipt.json
RISKBEX_HISTORICAL_DATA=/srv/riskbex/historical-data
RISKBEX_TLS_DATA=/srv/riskbex/tls/data
RISKBEX_TLS_CONFIG=/srv/riskbex/tls/config
