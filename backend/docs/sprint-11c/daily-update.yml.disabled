# INACTIVE TEMPLATE. Requires explicit activation and public-distribution approval.
name: MAIN daily Cloud publication
on:
  workflow_dispatch:
  schedule:
    - cron: '37 19,21 * * *'
permissions:
  contents: read
concurrency:
  group: riskbex-cloud-publication
  cancel-in-progress: false
jobs:
  update:
    if: github.ref == 'refs/heads/main' && vars.RISKBEX_PUBLIC_DISTRIBUTION_APPROVED == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: write
    env:
      OMP_NUM_THREADS: '1'
      OPENBLAS_NUM_THREADS: '1'
      MKL_NUM_THREADS: '1'
      RISKBEX_PUBLIC_DISTRIBUTION_APPROVED: 'true'
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: release/streamlit-rc1
          fetch-depth: 1
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.11.14'
      - run: python -m pip install -r backend/requirements-docker.lock
      - run: python -m pip check
      - name: Prepare and publish atomically
        shell: bash
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          reviewed_head=$(git rev-parse HEAD)
          python backend/scripts/run_actions_update.py --work "$RUNNER_TEMP/main-update" --fetch --publish --expected-head "$reviewed_head"
